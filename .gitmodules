[submodule "third_party/zlib"]
	path = third_party/zlib
	url = https://github.com/madler/zlib.git
[submodule "third_party/zstd"]
	path = third_party/zstd
	url = https://github.com/facebook/zstd.git
[submodule "third_party/coremark"]
	path = third_party/coremark
	url = https://github.com/eembc/coremark.git
[submodule "third_party/tinymembench"]
	path = third_party/tinymembench
	url = https://github.com/ssvb/tinymembench.git
[submodule "third_party/stream"]
	path = third_party/stream
	url = https://github.com/jeffhammond/STREAM.git
[submodule "third_party/gfxbench"]
	path = third_party/gfxbench
	url = https://github.com/Kishonti-Opensource/gfxbench.git
[submodule "third_party/mbedtls"]
	path = third_party/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "third_party/libjpeg-turbo"]
	path = third_party/libjpeg-turbo
	url = https://github.com/libjpeg-turbo/libjpeg-turbo.git
[submodule "third_party/libpng"]
	path = third_party/libpng
	url = https://github.com/pnggroup/libpng.git
[submodule "third_party/ffmpeg"]
	path = third_party/ffmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
