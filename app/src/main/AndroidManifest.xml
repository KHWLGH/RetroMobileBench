<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <provider
            android:name=".ExportFileProvider"
            android:authorities="com.retromobilebench.export"
            android:exported="false"
            android:grantUriPermissions="true" />
        <service
            android:name=".GpuService"
            android:process=":gpu"
            android:exported="false"
            android:stopWithTask="true" />
        <service android:name=".WebService" android:process=":web" android:exported="false" android:stopWithTask="true" />
        <activity android:name=".WebBenchmarkActivity" android:process=":web" android:exported="false" android:screenOrientation="portrait" android:configChanges="orientation|screenSize" android:hardwareAccelerated="true" />
        <service android:name=".MediaService" android:process=":media" android:exported="false" android:stopWithTask="true" />
        <activity android:name=".LegacyGpuActivity" android:process=":gpu" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />
        <activity android:name=".LegacyPlaybackActivity" android:process=":media" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />
        <activity android:name=".DisplayActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize" />
        <activity
            android:name=".MainActivity"
            android:theme="@style/MainTheme"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
